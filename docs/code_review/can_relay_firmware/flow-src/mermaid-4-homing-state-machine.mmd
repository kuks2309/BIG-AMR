    H_START --> H_ERR_ABORT : !pc_authority or safety_mode != 30 -> cancel frames (safety_seer_gate.h:576-579), or 0xea start=0 (safety_seer_gate.h:550-551)
    H_WAIT --> H_ERR_ABORT : !pc_authority or safety_mode != 30 -> cancel frames (safety_seer_gate.h:576-579), or 0xea start=0 (safety_seer_gate.h:550-551)
    H_RESTORE --> H_ERR_ABORT : !pc_authority or safety_mode != 30 -> cancel frames (safety_seer_gate.h:576-579), or 0xea start=0 (safety_seer_gate.h:550-551)
    H_GOZERO --> H_ERR_ABORT : !pc_authority or safety_mode != 30 -> cancel frames (safety_seer_gate.h:576-579), or 0xea start=0 (safety_seer_gate.h:550-551)
    H_GOZERO_W --> H_ERR_ABORT : !pc_authority or safety_mode != 30 -> cancel frames (safety_seer_gate.h:576-579), or 0xea start=0 (safety_seer_gate.h:550-551)
