stateDiagram-v2
    state "IDLE (0)" as H_IDLE
    state "ENABLE (1): 0x6040 = 0x86 (fault reset + enable) to node3 and node4" as H_ENABLE
    state "SET_SPEED (2): 0x6099 = seer_home_speed (default 2500 = 0.1 r/min units)" as H_SETSPEED
    state "START (3): 0x60FB sub4 = 1 (RstStart); stage_reset(); 0x6098 deliberately not written" as H_START
    state "WAIT (4): every 2nd tick (4 Hz) read 0x6041 and 0x6000.01; seen_active on bit15 == 0, done_mask on the 0 -> 1 transition" as H_WAIT
    state "RESTORE (8): 0x6060 = 1 (PP), 0x6081 = 30000, 0x6083 = 250, 0x6084 = 250" as H_RESTORE
    state "GOZERO (9): 0x607A = 7882020 (node3) / 7859062 (node4); 0x6040 = 0x3F" as H_GOZERO
    state "GOZERO_W (11): every 2nd tick read 0x6064 and 0x6000.01; reached when abs(pos - target) < 57344 counts (1.0 deg)" as H_GOZERO_W
    state "DONE (5) terminal" as H_DONE
    state "ERR_TIMEOUT (6) terminal - homing search timed out" as H_ERR_TIMEOUT
    state "ERR_ABORT (7) terminal - host abort or authority lost" as H_ERR_ABORT
    state "ERR_GOZERO (10) terminal - origin found but 0 deg return not confirmed" as H_ERR_GOZERO
    state "default: unknown state value" as H_DEFAULT
    state "seer_homing_tick() entry: seer_home_is_terminal(state) -> return immediately (absorbing until 0xea)" as H_TICKGUARD
