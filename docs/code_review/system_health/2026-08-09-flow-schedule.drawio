<mxfile host="app.diagrams.net" type="device">
  <diagram name="system_health-schedule" id="shsch1">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="write" value="ring.write / stdout" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="300" y="40" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="once" value="--once ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="320" y="130" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fin" value="return 0 / 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="grid" value="deadline = grid_start + cycle x interval" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="290" y="240" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="late" value="deadline 이 이미 지났나" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="300" y="330" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="skip" value="밀린 칸 건너뛰기 (따라잡기 금지)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="610" y="340" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sleep" value="_sleep_until(deadline)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="300" y="450" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="loop" value="루프 선두로" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="300" y="540" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="g1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="write" target="once">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="once" target="fin">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="once" target="grid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="grid" target="late">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g5" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="late" target="skip">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g6" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="late" target="sleep">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="skip" target="sleep">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="sleep" target="loop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
