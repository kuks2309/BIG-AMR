        <mxCell id="I" value="AmrTestController.connect()&amp;#10;backend 항등 구성(sign=+1)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="400" y="810" width="230" height="62" as="geometry"/></mxCell>
