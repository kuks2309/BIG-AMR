        <mxCell id="pc" value="PC = Neousys NRU-156U3-FT&#10;(Jetson Orin NX, 100 TOPS)&#10;추가기능 + Seer감시 + inject" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="730" y="150" width="240" height="90" as="geometry" />
        </mxCell>

        <mxCell id="cam" value="CAM1~6 = Orbbec Gemini E&#10;RGBD · USB2.0 ×6&#10;(3D 충돌회피·도킹)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
