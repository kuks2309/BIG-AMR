          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_plc_panda" value="①' 여유 CAN (D14)&#10;권한/heartbeat (PC 비의존)" style="endArrow=classic;startArrow=classic;html=1;fontSize=11;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="plc" target="panda">
          <mxGeometry relative="1" as="geometry" />
