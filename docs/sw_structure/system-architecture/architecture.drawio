        <mxCell id="tongy" value="Tongy 모터 드라이버&#10;AMR 휠 (CANopen CiA402)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="390" y="500" width="200" height="70" as="geometry" />
