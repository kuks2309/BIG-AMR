        </mxCell>
        <mxCell id="e_lidar_seer" value="nav 공유" style="endArrow=classic;html=1;fontSize=10;dashed=1;" edge="1" parent="1" source="lidar" target="seer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_lidar_safetyplc" value="OSSD 안전출력 (인증)" style="endArrow=classic;html=1;fontSize=11;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="lidar" target="safetyplc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_safetyplc_tongy" value="안전 정지 (하드와이어)" style="endArrow=classic;html=1;fontSize=11;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="safetyplc" target="tongy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="범례&#10;× = 기존 CAN 절단·릴레이 인라인 삽입    │    inject = 2-key (PLC CAN 허가 AND PC USB 명령)&#10;fail-safe(relay) = 무전원 → passthrough (normally-closed) + STM32 IWDG&#10;안전 정지(별도 체인) = SICK 안전 Lidar → Safety PLC → 모터 드라이버 정지  [Panda·연산과 독립, 인증]&#10;권한=PLC · 명령=PC · 감시(correctness)=엔코더 diverge + IMU · liveness=삼각 heartbeat&#10;Seer=기본내비(동결) · PC=추가기능+Seer감시+자율 시 주행대체&#10;※ Safety PLC = 권한 PLC 와 별도의 독립 안전 PLC (Q10 확정) — 안전 정지 체인은 제어/권한 체인과 물리 분리" style="text;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="730" width="930" height="150" as="geometry" />
        </mxCell>

      </root>
