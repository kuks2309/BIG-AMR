<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>trnav_2ws_gazebo</name>
  <version>0.1.0</version>
  <description>
    Gazebo Classic simulation for Foil_A082 (2WS inline dual-steer AMR).
    Replaces the CAN/motor layer below WheelSetArray with ros2_control.
  </description>
  <maintainer email="habib.usa2014@gmail.com">T-Robotics</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>trnav_2ws_description</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_ros2_control</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>position_controllers</exec_depend>
  <exec_depend>velocity_controllers</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <!-- The MES that gives the fleet work. fleet.launch.py starts it by default
       (mes:=false opts out), so the fleet cannot come up with nothing driving
       it. This does point Sim at MES, the opposite of the usual direction; it
       is an exec_depend only — no Sim code imports csm, the launch file just
       names the executable. -->
  <exec_depend>csm</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
