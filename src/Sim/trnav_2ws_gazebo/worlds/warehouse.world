<?xml version="1.0"?>
<!--
  warehouse.world — Foil_A082 주행 확인용 최소 환경.

  넓은 바닥 + 벽 몇 개 + 파렛트 박스 몇 개. 라이다가 볼 대상이 있어야
  scan_front / scan_rear 가 의미 있는 데이터를 낸다.
  로봇 자체는 launch 에서 spawn_entity 로 넣는다(월드에 하드코딩하지 않음).
-->
<sdf version="1.6">
  <world name="warehouse">

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.80 0.86 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ===== 벽 (12 m × 12 m 홀) ===== -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 10 1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>20 0.2 2</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>20 0.2 2</size></box></geometry>
          <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -10 1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>20 0.2 2</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>20 0.2 2</size></box></geometry>
          <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>10 0 1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 20 2</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.2 20 2</size></box></geometry>
          <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-10 0 1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 20 2</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.2 20 2</size></box></geometry>
          <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar">
      <static>true</static>
      <pose>0 2.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>2.5</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.25</radius><length>2.5</length></cylinder></geometry>
          <material><ambient>0.4 0.42 0.45 1</ambient><diffuse>0.5 0.52 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>


    <!-- station_3: a process station. Static, and low enough that the robot's
         scanners see it as an obstacle to be avoided, exactly as on a real
         floor where you drive up beside a machine, not into it. -->
    <model name="m_1A01">
      <static>true</static>
      <pose>6.0 -6.0 0 0 0 0</pose>
      <link name="link">
        <!-- table top -->
        <collision name="top_c">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><box><size>1.0 0.8 0.1</size></box></geometry>
        </collision>
        <visual name="top_v">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><box><size>1.0 0.8 0.1</size></box></geometry>
          <material>
            <ambient>0.85 0.25 0.20 1</ambient><diffuse>0.85 0.25 0.20 1</diffuse>
          </material>
        </visual>
        <!-- legs, as one block: keeps the model cheap and still blocks the robot -->
        <collision name="base_c">
          <pose>0 0 0.2 0 0 0</pose>
          <geometry><box><size>0.8 0.6 0.4</size></box></geometry>
        </collision>
        <visual name="base_v">
          <pose>0 0 0.2 0 0 0</pose>
          <geometry><box><size>0.8 0.6 0.4</size></box></geometry>
          <material>
            <ambient>0.30 0.32 0.35 1</ambient><diffuse>0.38 0.40 0.44 1</diffuse>
          </material>
        </visual>
        <!-- post so the station is identifiable from across the hall -->
        <visual name="post_v">
          <pose>0 0 0.85 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.7</length></cylinder></geometry>
          <material>
            <ambient>0.85 0.25 0.20 1</ambient><diffuse>0.85 0.25 0.20 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- station_5: a process station. Static, and low enough that the robot's
         scanners see it as an obstacle to be avoided, exactly as on a real
         floor where you drive up beside a machine, not into it. -->
    <model name="m_ASRS">
      <static>true</static>
      <pose>-6.0 -6.0 0 0 0 0</pose>
      <link name="link">
        <!-- table top -->
        <collision name="top_c">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><box><size>1.0 0.8 0.1</size></box></geometry>
        </collision>
        <visual name="top_v">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><box><size>1.0 0.8 0.1</size></box></geometry>
          <material>
            <ambient>0.20 0.55 0.85 1</ambient><diffuse>0.20 0.55 0.85 1</diffuse>
          </material>
        </visual>
        <!-- legs, as one block: keeps the model cheap and still blocks the robot -->
        <collision name="base_c">
          <pose>0 0 0.2 0 0 0</pose>
          <geometry><box><size>0.8 0.6 0.4</size></box></geometry>
        </collision>
        <visual name="base_v">
          <pose>0 0 0.2 0 0 0</pose>
          <geometry><box><size>0.8 0.6 0.4</size></box></geometry>
          <material>
            <ambient>0.30 0.32 0.35 1</ambient><diffuse>0.38 0.40 0.44 1</diffuse>
          </material>
        </visual>
        <!-- post so the station is identifiable from across the hall -->
        <visual name="post_v">
          <pose>0 0 0.85 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.7</length></cylinder></geometry>
          <material>
            <ambient>0.20 0.55 0.85 1</ambient><diffuse>0.20 0.55 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- station_9: a process station. Static, and low enough that the robot's
         scanners see it as an obstacle to be avoided, exactly as on a real
         floor where you drive up beside a machine, not into it. -->
    <model name="m_1T01">
      <static>true</static>
      <pose>6.0 6.0 0 0 0 0</pose>
      <link name="link">
        <!-- table top -->
        <collision name="top_c">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><box><size>1.0 0.8 0.1</size></box></geometry>
        </collision>
        <visual name="top_v">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><box><size>1.0 0.8 0.1</size></box></geometry>
          <material>
            <ambient>0.30 0.70 0.35 1</ambient><diffuse>0.30 0.70 0.35 1</diffuse>
          </material>
        </visual>
        <!-- legs, as one block: keeps the model cheap and still blocks the robot -->
        <collision name="base_c">
          <pose>0 0 0.2 0 0 0</pose>
          <geometry><box><size>0.8 0.6 0.4</size></box></geometry>
        </collision>
        <visual name="base_v">
          <pose>0 0 0.2 0 0 0</pose>
          <geometry><box><size>0.8 0.6 0.4</size></box></geometry>
          <material>
            <ambient>0.30 0.32 0.35 1</ambient><diffuse>0.38 0.40 0.44 1</diffuse>
          </material>
        </visual>
        <!-- post so the station is identifiable from across the hall -->
        <visual name="post_v">
          <pose>0 0 0.85 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.7</length></cylinder></geometry>
          <material>
            <ambient>0.30 0.70 0.35 1</ambient><diffuse>0.30 0.70 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- station_out: a process station. Static, and low enough that the robot's
         scanners see it as an obstacle to be avoided, exactly as on a real
         floor where you drive up beside a machine, not into it. -->
    <model name="m_1L01">
      <static>true</static>
      <pose>-6.0 6.0 0 0 0 0</pose>
      <link name="link">
        <!-- table top -->
        <collision name="top_c">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><box><size>1.0 0.8 0.1</size></box></geometry>
        </collision>
        <visual name="top_v">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><box><size>1.0 0.8 0.1</size></box></geometry>
          <material>
            <ambient>0.85 0.70 0.15 1</ambient><diffuse>0.85 0.70 0.15 1</diffuse>
          </material>
        </visual>
        <!-- legs, as one block: keeps the model cheap and still blocks the robot -->
        <collision name="base_c">
          <pose>0 0 0.2 0 0 0</pose>
          <geometry><box><size>0.8 0.6 0.4</size></box></geometry>
        </collision>
        <visual name="base_v">
          <pose>0 0 0.2 0 0 0</pose>
          <geometry><box><size>0.8 0.6 0.4</size></box></geometry>
          <material>
            <ambient>0.30 0.32 0.35 1</ambient><diffuse>0.38 0.40 0.44 1</diffuse>
          </material>
        </visual>
        <!-- post so the station is identifiable from across the hall -->
        <visual name="post_v">
          <pose>0 0 0.85 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.7</length></cylinder></geometry>
          <material>
            <ambient>0.85 0.70 0.15 1</ambient><diffuse>0.85 0.70 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <gui>
      <camera name="user_camera">
        <pose>-6.5 -6.5 5.5 0 0.45 0.78</pose>
      </camera>
    </gui>
    <!-- Ground truth for every model, on ONE topic.
         The per-model p3d plugin does not survive multi-robot: each copy needs
         its own ROS namespace and its own plugin name, and even then the
         bindings came out crossed — two plugins on /amr1/odom_truth and none on
         /amr2. This is a single world-level plugin publishing every model's
         pose by NAME on /gazebo/model_states, so a robot looks itself up
         instead of relying on per-model plumbing being right. -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>30.0</update_rate>
    </plugin>


  

    <!-- parallel gravure machine: three of them share the store,
         which is what gives the fleet more than one job at a time -->
    <model name="m_1A02">
      <static>true</static>
      <pose>7.0 -1.5 0 0 0 0</pose>
      <link name="link">
        <!-- table top -->
        <collision name="top_c">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><box><size>1.0 0.8 0.1</size></box></geometry>
        </collision>
        <visual name="top_v">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><box><size>1.0 0.8 0.1</size></box></geometry>
          <material>
            <ambient>0.85 0.25 0.20 1</ambient><diffuse>0.85 0.25 0.20 1</diffuse>
          </material>
        </visual>
        <!-- legs, as one block: keeps the model cheap and still blocks the robot -->
        <collision name="base_c">
          <pose>0 0 0.2 0 0 0</pose>
          <geometry><box><size>0.8 0.6 0.4</size></box></geometry>
        </collision>
        <visual name="base_v">
          <pose>0 0 0.2 0 0 0</pose>
          <geometry><box><size>0.8 0.6 0.4</size></box></geometry>
          <material>
            <ambient>0.30 0.32 0.35 1</ambient><diffuse>0.38 0.40 0.44 1</diffuse>
          </material>
        </visual>
        <!-- post so the station is identifiable from across the hall -->
        <visual name="post_v">
          <pose>0 0 0.85 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.7</length></cylinder></geometry>
          <material>
            <ambient>0.85 0.25 0.20 1</ambient><diffuse>0.85 0.25 0.20 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- parallel gravure machine: three of them share the store,
         which is what gives the fleet more than one job at a time -->
    <model name="m_1A03">
      <static>true</static>
      <pose>2.0 -2.5 0 0 0 0</pose>
      <link name="link">
        <!-- table top -->
        <collision name="top_c">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><box><size>1.0 0.8 0.1</size></box></geometry>
        </collision>
        <visual name="top_v">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><box><size>1.0 0.8 0.1</size></box></geometry>
          <material>
            <ambient>0.85 0.25 0.20 1</ambient><diffuse>0.85 0.25 0.20 1</diffuse>
          </material>
        </visual>
        <!-- legs, as one block: keeps the model cheap and still blocks the robot -->
        <collision name="base_c">
          <pose>0 0 0.2 0 0 0</pose>
          <geometry><box><size>0.8 0.6 0.4</size></box></geometry>
        </collision>
        <visual name="base_v">
          <pose>0 0 0.2 0 0 0</pose>
          <geometry><box><size>0.8 0.6 0.4</size></box></geometry>
          <material>
            <ambient>0.30 0.32 0.35 1</ambient><diffuse>0.38 0.40 0.44 1</diffuse>
          </material>
        </visual>
        <!-- post so the station is identifiable from across the hall -->
        <visual name="post_v">
          <pose>0 0 0.85 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.7</length></cylinder></geometry>
          <material>
            <ambient>0.85 0.25 0.20 1</ambient><diffuse>0.85 0.25 0.20 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
