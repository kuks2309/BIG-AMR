<?xml version="1.0"?>
<!--
  Foil_A082 - 2WS inline dual-steer AMR, Gazebo Classic 11 simulation model.

  Geometry SSOT: src/Control/Motion_Control/2WS/trnav_2ws_core/config/robot_geometry_2ws.yaml
      W1 Front = (+0.6039, -0.0014)   steer + drive
      W2 Rear  = (-0.5961, -0.0014)   steer + drive
      wheel_radius = 0.125            wheelbase = 1.200
      steer limit  = +/-90 deg        (spin_params.yaml steer_limit_deg)

  PLACEHOLDER values (not measured yet - waiting on real numbers):
      BODY_L / BODY_W / BODY_H / MASS   chassis envelope and mass
      caster positions, lidar and IMU mount coordinates
    Note: body_length 1.1974 in the action-server params yaml is a leftover
    Carrier AGV value. It is SHORTER than the 1.2 m wheelbase, so it cannot be
    the real chassis - deliberately not used here.

  The two drive wheels are inline on the centerline, so the robot is laterally
  unstable like a bicycle. Four passive casters at the corners give it a stable
  4-point stance in simulation.
-->
<robot name="foil_a082" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Namespace for multi-robot worlds. Empty means the single-robot topics
       (/cmd_vel, /odom_truth, /scan_front) exactly as before, so nothing that
       already works has to change. Set it and every plugin, topic and TF frame
       moves under that prefix, which is what lets several robots share one
       Gazebo world without shouting over each other. -->
  <xacro:arg name="ns" default=""/>
  <xacro:property name="NS" value="$(arg ns)"/>

  <!-- Draw the laser fans in the Gazebo window. Useful with ONE robot, where
       two fans show you what the scanners see. Unusable with three: six fans of
       400 rays each fill the hall with colour and you cannot see the robots at
       all. Off by default; turn it on when you are debugging the scanners. -->
  <xacro:arg name="show_scan" default="false"/>

  <!-- Body colour per LEG, not per robot. Identical grey robots in one window
       are impossible to tell apart, which makes every observation about "the
       robot" ambiguous — and an ambiguous observation is worse than none,
       because it sends the diagnosis somewhere wrong. What you need to read off
       the window is which leg of the material flow a robot is serving, so that
       is what the colour carries: A red, B green, C blue. Robots on the same
       leg are the same colour on purpose — they are interchangeable, and the
       CSM treats them that way. The single-robot world passes no segment and
       stays grey.

       KEYED OFF THE SEGMENT, NOT THE NAME. It used to be three xacro:if cases
       on the namespace — amr1 red, amr2 green, amr3 blue — and every robot
       past the third fell through to the default. At robots:=5 that put amr4
       and amr5 on segment C in DarkGrey, the same grey the single-robot world
       uses, so the window showed four colours for three legs. This is the same
       failure fleet.launch.py records against its own hand-written fleet tuple:
       a list written out by hand caps the fleet at the length of the list. The
       leg map lives in csm/plant.py ROBOT_SEGMENT and the launch passes it in,
       so this stays right at the deck's full ten. -->
  <!-- xacro:if rather than a dict lookup: xacro's ${...} parser is naive and
       the dict's own closing brace terminates the expression, failing with
       "'{' was never closed". Conditionals have no braces to trip over. -->
  <xacro:arg name="segment" default=""/>
  <xacro:property name="SEGMENT" value="$(arg segment)"/>
  <xacro:property name="BODY_COLOUR" value="Gazebo/DarkGrey"/>
  <xacro:if value="${SEGMENT == 'A'}">
    <xacro:property name="BODY_COLOUR" value="Gazebo/Red"/>
  </xacro:if>
  <xacro:if value="${SEGMENT == 'B'}">
    <xacro:property name="BODY_COLOUR" value="Gazebo/Green"/>
  </xacro:if>
  <xacro:if value="${SEGMENT == 'C'}">
    <xacro:property name="BODY_COLOUR" value="Gazebo/Blue"/>
  </xacro:if>
  <xacro:property name="PFX" value="${NS + '/' if NS else ''}"/>

  <!-- ABSOLUTE TOPIC PREFIX (2026-08-06). Measured, not assumed: Gazebo gives a
       plugin's node the namespace of the PREVIOUSLY inserted model, not its own.
       From one clean three-robot run:

         [amr1.amr1_gazebo_ros2_control] ... in namespace: /amr1   (right)
         [amr1.amr2_gazebo_ros2_control] ... in namespace: /amr1   (wrong)
         [amr2.amr3_gazebo_ros2_control] ... in namespace: /amr2   (wrong)

       The model SDF Gazebo holds is correct — `gz model -m amr2 -i` shows
       <namespace>/amr2</namespace> — so the description is not at fault and no
       change to it can fix the namespace. Only controller_manager escapes,
       because gazebo_ros2_control reads the SDF itself rather than inheriting
       the plugin node's namespace.

       The consequence was severe and silent: amr2's sensors and ground truth
       published into /amr1, so /amr1/odom_truth carried two robots' poses
       alternately, and amr3 had no scans, no IMU and no ground truth at all.

       So do not rely on the namespace. Every plugin topic below is written
       ABSOLUTE via this prefix, which resolves the same wherever the node
       lands. Empty namespace gives /scan_front, /odom_truth ... exactly the
       single-robot topics sim.launch.py already expects. -->
  <xacro:property name="TNS" value="${'/' + NS if NS else ''}"/>

  <!-- ===================== parameters ===================== -->
  <!-- Measured (robot_geometry_2ws.yaml) -->
  <xacro:property name="W1_X" value="0.6039"/>
  <xacro:property name="W1_Y" value="-0.0014"/>
  <xacro:property name="W2_X" value="-0.5961"/>
  <xacro:property name="W2_Y" value="-0.0014"/>
  <xacro:property name="WHEEL_R" value="0.125"/>
  <xacro:property name="WHEEL_W" value="0.080"/>
  <!-- TEST 2026-08-07: +/-115 deg, not 90.
       Both drive wheels are on the centreline, so a pure sideways crab — which
       is exactly what docking does — needs both wheels at +/-90 deg. At a 90 deg
       limit that is the HARD STOP, and docking froze there: two robots reached
       range 0.45 m against a 0.65 m target, sat perfectly still for 90 s and
       timed out. The docks that succeeded were the ones a few degrees OFF
       parallel, where the demand stays inside travel.
       115 deg leaves 25 deg of margin at the crab. Session memory records the
       real limit being changed from 90 to 115; if this run docks cleanly that
       is confirmed, and if not the limit was never the problem. -->
  <xacro:property name="STEER_LIMIT" value="2.0071286397934789"/>  <!-- +/-115 deg -->

  <!-- PLACEHOLDER - change here and the whole model follows -->
  <xacro:property name="BODY_L" value="1.600"/>
  <xacro:property name="BODY_W" value="0.900"/>
  <xacro:property name="BODY_H" value="0.500"/>
  <xacro:property name="BODY_Z" value="0.260"/>   <!-- chassis centre height above base_link -->
  <xacro:property name="MASS"   value="250.0"/>

  <xacro:property name="CASTER_R" value="0.050"/>
  <xacro:property name="CASTER_X" value="0.680"/>
  <xacro:property name="CASTER_Y" value="0.370"/>

  <xacro:property name="PI" value="3.14159265358979"/>
  <xacro:property name="PI2" value="1.5707963267948966"/>

  <material name="body_grey"><color rgba="0.80 0.82 0.86 1.0"/></material>
  <material name="body_dark"><color rgba="0.25 0.27 0.32 1.0"/></material>
  <material name="wheel_black"><color rgba="0.10 0.10 0.10 1.0"/></material>
  <material name="steer_blue"><color rgba="0.20 0.45 0.85 1.0"/></material>
  <material name="lidar_yellow"><color rgba="0.95 0.80 0.10 1.0"/></material>
  <material name="imu_green"><color rgba="0.20 0.75 0.35 1.0"/></material>

  <!-- ===================== macros ===================== -->

  <!-- One steer + drive module. Maps to two CANopen nodes on the real robot. -->
  <xacro:macro name="steer_drive_module" params="name x y">
    <!-- Steering link: rotates about z relative to base_link -->
    <link name="${name}_steer_link">
      <visual>
        <origin xyz="0 0 0.055"/>
        <geometry><cylinder radius="0.075" length="0.110"/></geometry>
        <material name="steer_blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.055"/>
        <geometry><cylinder radius="0.075" length="0.110"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.055"/>
        <mass value="8.0"/>
        <inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.02"/>
      </inertial>
    </link>

    <joint name="${name}_steer_joint" type="revolute">
      <parent link="base_link"/>
      <child  link="${name}_steer_link"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <!-- +/-90 deg: same range the IK normalizes steering angles into -->
      <limit lower="${-STEER_LIMIT}" upper="${STEER_LIMIT}" effort="500.0" velocity="3.0"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <!-- Drive link: rotates about y relative to the steering link -->
    <link name="${name}_wheel_link">
      <visual>
        <origin rpy="${PI2} 0 0"/>
        <geometry><cylinder radius="${WHEEL_R}" length="${WHEEL_W}"/></geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin rpy="${PI2} 0 0"/>
        <geometry><cylinder radius="${WHEEL_R}" length="${WHEEL_W}"/></geometry>
      </collision>
      <inertial>
        <mass value="6.0"/>
        <inertia ixx="0.03" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.03"/>
      </inertial>
    </link>

    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="${name}_steer_link"/>
      <child  link="${name}_wheel_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="500.0" velocity="50.0"/>
      <dynamics damping="0.05" friction="0.05"/>
    </joint>

    <gazebo reference="${name}_wheel_link">
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
      <kp>1e6</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <material>Gazebo/Black</material>
    </gazebo>
    <gazebo reference="${name}_steer_link">
      <material>Gazebo/Blue</material>
    </gazebo>
  </xacro:macro>

  <!-- Passive spherical caster: keeps the inline 2-wheel robot from tipping sideways -->
  <xacro:macro name="caster" params="name x y">
    <link name="${name}_caster_link">
      <visual>
        <geometry><sphere radius="${CASTER_R}"/></geometry>
        <material name="body_dark"/>
      </visual>
      <collision>
        <geometry><sphere radius="${CASTER_R}"/></geometry>
      </collision>
      <inertial>
        <mass value="1.0"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="${name}_caster_link"/>
      <origin xyz="${x} ${y} ${CASTER_R - WHEEL_R}"/>
    </joint>
    <gazebo reference="${name}_caster_link">
      <!-- Near-frictionless so casters do not fight the driven wheels -->
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
      <kp>1e6</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <material>Gazebo/DarkGrey</material>
    </gazebo>
  </xacro:macro>

  <!-- ===================== chassis ===================== -->

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${WHEEL_R}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${BODY_Z}"/>
      <geometry><box size="${BODY_L} ${BODY_W} ${BODY_H}"/></geometry>
      <material name="body_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${BODY_Z}"/>
      <geometry><box size="${BODY_L} ${BODY_W} ${BODY_H}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${BODY_Z}"/>
      <mass value="${MASS}"/>
      <inertia
        ixx="${MASS*(BODY_W*BODY_W + BODY_H*BODY_H)/12.0}" ixy="0" ixz="0"
        iyy="${MASS*(BODY_L*BODY_L + BODY_H*BODY_H)/12.0}" iyz="0"
        izz="${MASS*(BODY_L*BODY_L + BODY_W*BODY_W)/12.0}"/>
    </inertial>
  </link>
  <gazebo reference="base_link"><material>${BODY_COLOUR}</material></gazebo>

  <!-- Yellow bar marking the front, so heading is obvious in the GUI -->
  <link name="front_marker_link">
    <visual>
      <geometry><box size="0.05 ${BODY_W*0.8} 0.06"/></geometry>
      <material name="lidar_yellow"/>
    </visual>
  </link>
  <joint name="front_marker_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="front_marker_link"/>
    <origin xyz="${BODY_L/2.0} 0 ${BODY_Z + BODY_H/2.0}"/>
  </joint>
  <gazebo reference="front_marker_link"><material>Gazebo/Yellow</material></gazebo>

  <!-- ===================== drive modules (W1 front / W2 rear) ===================== -->
  <xacro:steer_drive_module name="w1" x="${W1_X}" y="${W1_Y}"/>
  <xacro:steer_drive_module name="w2" x="${W2_X}" y="${W2_Y}"/>

  <!-- ===================== four casters ===================== -->
  <xacro:caster name="fl" x="${CASTER_X}"  y="${CASTER_Y}"/>
  <xacro:caster name="fr" x="${CASTER_X}"  y="${-CASTER_Y}"/>
  <xacro:caster name="rl" x="${-CASTER_X}" y="${CASTER_Y}"/>
  <xacro:caster name="rr" x="${-CASTER_X}" y="${-CASTER_Y}"/>

  <!-- ===================== sensors ===================== -->
  <!-- Two SICK 2D safety scanners (front / rear). Mount coordinates are
       PLACEHOLDER. On the real robot seer_lidar_tf fetches the TF from the
       Seer controller over TCP API 1009. -->
  <link name="scan_front_link">
    <visual>
      <geometry><cylinder radius="0.055" length="0.080"/></geometry>
      <material name="lidar_yellow"/>
    </visual>
    <!-- No <collision> on a sensor link. The ray sensor's origin is the link
         origin, so a collision shell here is geometry the sensor sits inside:
         every beam strikes it at the shell radius and the scan reads a constant
         0.05-0.08 m in all directions, blinding the robot completely. -->
    <inertial><mass value="0.5"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="scan_front_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="scan_front_link"/>
    <!-- Mounted PROTRUDING past the body face and ABOVE the body top.
         At the original (BODY_L/2 - 0.06, z = BODY_Z - 0.10) the sensor sat
         inside the chassis box, so every beam struck the robot's own collision
         geometry and returned 0.05-0.08 m in all directions — which made the
         obstacle-avoidance field enormous and random. -->
    <origin xyz="${BODY_L/2.0 + 0.08} 0 ${BODY_Z + BODY_H/2.0 + 0.05}" rpy="0 0 0"/>
  </joint>
  <gazebo reference="scan_front_link"><material>Gazebo/Yellow</material></gazebo>

  <link name="scan_rear_link">
    <visual>
      <geometry><cylinder radius="0.055" length="0.080"/></geometry>
      <material name="lidar_yellow"/>
    </visual>
    <!-- No <collision> on a sensor link. The ray sensor's origin is the link
         origin, so a collision shell here is geometry the sensor sits inside:
         every beam strikes it at the shell radius and the scan reads a constant
         0.05-0.08 m in all directions, blinding the robot completely. -->
    <inertial><mass value="0.5"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="scan_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="scan_rear_link"/>
    <origin xyz="${-BODY_L/2.0 - 0.08} 0 ${BODY_Z + BODY_H/2.0 + 0.05}" rpy="0 0 ${PI}"/>
  </joint>
  <gazebo reference="scan_rear_link"><material>Gazebo/Yellow</material></gazebo>

  <!-- iAHRS IMU. (-0.37, 0, 0.29) is the TR-AMR value carried over in debt-002;
       Big-AMR's real mount point has not been measured yet. -->
  <link name="imu_link">
    <visual>
      <geometry><box size="0.05 0.05 0.02"/></geometry>
      <material name="imu_green"/>
    </visual>
    <inertial><mass value="0.05"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="-0.37 0 0.29" rpy="0 0 0"/>
  </joint>
  <gazebo reference="imu_link"><material>Gazebo/Green</material></gazebo>

  <!-- ===================== Gazebo sensor plugins ===================== -->
  <gazebo reference="scan_front_link">
    <sensor type="ray" name="scan_front_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>$(arg show_scan)</visualize>
      <update_rate>25.0</update_rate>
      <ray>
        <scan>
          <horizontal>
            <!-- SICK safety scanner class: 275 deg field of view -->
            <samples>400</samples>
            <resolution>1</resolution>
            <min_angle>-1.745</min_angle>
            <max_angle>1.745</max_angle>
          </horizontal>
        </scan>
        <range><min>0.05</min><max>25.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
      </ray>
      <plugin name="${NS + '_' if NS else ''}scan_front_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/${NS}</namespace>
          <remapping>~/out:=${TNS}/scan_front</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>scan_front_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="scan_rear_link">
    <sensor type="ray" name="scan_rear_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>$(arg show_scan)</visualize>
      <update_rate>25.0</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>400</samples>
            <resolution>1</resolution>
            <min_angle>-1.745</min_angle>
            <max_angle>1.745</max_angle>
          </horizontal>
        </scan>
        <range><min>0.05</min><max>25.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
      </ray>
      <plugin name="${NS + '_' if NS else ''}scan_rear_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/${NS}</namespace>
          <remapping>~/out:=${TNS}/scan_rear</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>scan_rear_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <!-- Same topic the real iahrs_driver publishes on -->
      <update_rate>100</update_rate>
      <plugin name="${NS + '_' if NS else ''}imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/${NS}</namespace>
          <remapping>~/out:=${TNS}/imu/data</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Ground-truth pose, simulation only.
       Wheel odometry integrates wheel rotation, so a robot pushing against an
       obstacle reports metres of travel it never made — the wheels turn, the
       chassis does not. That is correct behaviour for wheel odometry and not a
       bug, but it means /odom alone cannot distinguish "arrived" from "stuck".
       This publishes the simulator's true pose on /odom_truth so the two can be
       compared. On the real robot the equivalent would come from Seer's own
       localisation or SLAM; nothing here should assume /odom_truth exists. -->
  <gazebo>
    <plugin name="${NS + '_' if NS else ''}ground_truth" filename="libgazebo_ros_p3d.so">
      <ros>
        <namespace>/${NS}</namespace>
        <remapping>odom:=${TNS}/odom_truth</remapping>
      </ros>
      <frame_name>world</frame_name>
      <!-- base_footprint, not base_link: Gazebo lumps links joined by fixed
           joints into their parent, so base_link is absorbed and only the root
           survives as a body. Naming base_link here fails with
           "body_name: base_link does not exist". -->
      <!-- Unscoped, deliberately. gazebo_ros_p3d looks the link up inside the
           model it is attached to, so a bare name is already model-local and
           prefixing it with the model name finds nothing.
           The crossed poses seen on 2026-08-05 were a plugin NAME collision —
           three models each declaring name="ground_truth" — not a body lookup
           problem. That is fixed above; this stays simple. -->
      <body_name>base_footprint</body_name>
      <update_rate>30.0</update_rate>
      <gaussian_noise>0.0</gaussian_noise>
    </plugin>
  </gazebo>

  <!-- ===================== docking cameras ===================== -->
  <!-- TWO cameras, one per side, optical axis along body +/-y.
       Mounting mirrors the docking project (docking_gui_dist), which carries a
       RealSense on each side: left_link (0, +0.34, 0.16) yaw +pi/2, right_link
       the mirror of it. Scaled to this chassis, which is 0.9 m wide.

       They face SIDEWAYS because the robot crabs into a dock: the machine is
       beside it, never ahead. That is also why the drive controller holds its
       aisle heading on a docking spur — turning to face the machine would swing
       the marker out of both cameras' view. -->
  <!-- AT THE BODY EDGE, flush. Moving these inboard looked like it would buy
       working distance for the lens, and instead put the robot's own chassis in
       the bottom third of the frame: the body half-width is 0.45 and its top is
       only 0.04 m below the lens, so from 0.20 m the camera stares across its
       own roof and the marker is clipped from below. Flush with the edge, the
       body is behind the lens and cannot occlude anything.

       The cost is that at the docked standoff the lens is only 0.16 m from the
       marker and sees 0.22 m of width — which is what sets the marker size. -->
  <xacro:property name="CAM_Y" value="0.46"/>
  <xacro:property name="CAM_Z" value="0.55"/>

  <xacro:macro name="dock_camera" params="side y yaw">
    <link name="cam_${side}_link">
      <visual>
        <geometry><box size="0.03 0.10 0.03"/></geometry>
        <material name="imu_green"/>
      </visual>
      <inertial><mass value="0.1"/><inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial>
    </link>
    <joint name="cam_${side}_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="cam_${side}_link"/>
      <origin xyz="0 ${y} ${CAM_Z}" rpy="0 0 ${yaw}"/>
    </joint>
    <gazebo reference="cam_${side}_link">
      <sensor type="camera" name="dock_cam_${side}">
        <update_rate>15.0</update_rate>
        <visualize>false</visualize>
        <camera>
          <!-- ~69 deg horizontal, the D435 colour stream. The docking
               observation model assumes a 55 deg half-angle; this is wider,
               so what the controller is told it can see, it really can. -->
          <horizontal_fov>1.204</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>30.0</far></clip>
        </camera>
        <plugin name="${NS + '_' if NS else ''}dock_cam_${side}" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/${NS}</namespace>
            <!-- Source name is the CAMERA NAME, not ~. gazebo_ros_camera
                 publishes on "<camera_name>/image_raw" relative to its node,
                 so a "~/image_raw" rule never matches and the absolute target
                 is silently not applied — which let Gazebo's namespace shift
                 put amr2's cameras onto /amr1 and lose amr3's entirely.
                 Measured: /amr1/dock_camera_left/image_raw had 2 publishers. -->
            <remapping>dock_camera_${side}/image_raw:=${TNS}/dock_camera_${side}/image_raw</remapping>
            <remapping>dock_camera_${side}/camera_info:=${TNS}/dock_camera_${side}/camera_info</remapping>
          </ros>
          <camera_name>dock_camera_${side}</camera_name>
          <frame_name>${NS + '_' if NS else ''}cam_${side}_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:dock_camera side="left"  y="${CAM_Y}"  yaw="${PI2}"/>
  <xacro:dock_camera side="right" y="${-CAM_Y}" yaw="${-PI2}"/>

  <!-- ===================== ros2_control ===================== -->
  <!-- Stands in for the real CANopen SDO layer:
       steering = position control, drive = velocity control -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <joint name="w1_steer_joint">
      <command_interface name="position">
        <param name="min">${-STEER_LIMIT}</param>
        <param name="max">${STEER_LIMIT}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="w2_steer_joint">
      <command_interface name="position">
        <param name="min">${-STEER_LIMIT}</param>
        <param name="max">${STEER_LIMIT}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="w1_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-50.0</param>
        <param name="max">50.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="w2_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-50.0</param>
        <param name="max">50.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin name="${NS + '_' if NS else ''}gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>$(find trnav_2ws_gazebo)/config/controllers.yaml</parameters>
      <!-- One controller_manager PER ROBOT. Without this every robot loads its
           controllers into the same manager, and the second spawn fails with a
           name clash — or worse, succeeds and drives the wrong wheels. -->
      <ros>
        <namespace>/${NS}</namespace>
      </ros>
    </plugin>
  </gazebo>

</robot>
