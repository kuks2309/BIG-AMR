<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>translate_sim_odom</name>
  <version>0.1.0</version>
  <description>Closed-loop SIL odometry simulator for amr_translate_node. Subscribes /motor/wheel_cmd (WheelSetArray) → 2-wheel IK → integrates → publishes TF map→base_link, /rtabmap/localization_pose, /imu/data, /wheel_motor_state.</description>
  <maintainer email="amap@t-robotics.com">amap</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>trnav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
