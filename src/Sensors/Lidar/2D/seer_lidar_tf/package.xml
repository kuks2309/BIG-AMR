<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>seer_lidar_tf</name>
  <version>0.2.0</version>
  <description>Read 2D LiDAR mounting pose (install_info) from a SEER SRC controller via the
    Robokit TCP API (port 19204, API 1009) and publish base_footprint -&gt; scan_* static TF.</description>
  <maintainer email="kukwonko@gmail.com">Big-AMR</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>tf2_ros</depend>
  <depend>geometry_msgs</depend>
  <depend>seer_tcp_ip</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
