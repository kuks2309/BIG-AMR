# 방향 결정 (매뉴얼 §5.1.3 Table 5.6). 상수값 = 응답 비트 배치 (LL<<1 | RL) 와 동일.
uint8 DIRECTION_NONE=0      # 선택 해제 → 장치는 error code 5 상태
uint8 DIRECTION_RIGHT=1     # 우측 레인 추종
uint8 DIRECTION_LEFT=2      # 좌측 레인 추종
uint8 DIRECTION_STRAIGHT=3  # 직진

uint8 direction
---
bool success                # 텔레그램 송수신·체크섬 정상
uint8 applied               # 장치가 응답한 LL/RL 비트 (위 상수와 동일 배치)
