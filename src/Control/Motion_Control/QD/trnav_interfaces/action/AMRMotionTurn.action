# AMRMotionTurn Action - R-turn (arc motion with radius R > 0)
# trnav_interfaces/action/AMRMotionTurn

# Goal
float32 target_angle          # deg (+ CCW, - CW)
float32 turn_radius           # m (> 0, robot center to ICR)
float32 max_linear_speed      # m/s (always > 0)
float32 accel_angle           # deg (accel/decel angular distance, > 0)
bool    hold_steer            # true: skip Phase 4, keep R-turn steer angle
float32 exit_steer_angle      # deg: Phase 4 target steer (ignored if hold_steer)
---
# Result
int8    status                # 0=success, -1=cancelled, -2=invalid_param, -3=timeout
float32 actual_angle          # deg (achieved rotation)
float32 elapsed_time          # sec
---
# Feedback
float32 current_angle         # deg (accumulated so far)
float32 current_linear_speed  # m/s (current linear speed)
float32 current_angular_speed # deg/s (current angular speed)
float32 remaining_angle       # deg (remaining angle)
uint8   phase                 # 0=steer_align, 1=accel, 2=cruise, 3=decel, 4=steer_return
float32 w1_drive_rpm          # W1 drive motor RPM (+FWD/-REV)
float32 w2_drive_rpm          # W2 drive motor RPM (+FWD/-REV)
