# AMRMotionPurePursuitReverse Action — nav_msgs/Path 다중 waypoint 후진 추종 (BICYCLE 전륜)
# trnav_2ws_interfaces/action/AMRMotionPurePursuitReverse
#
# 알고리즘: Pure Pursuit Reverse (translate_reverse 패턴 준용)
#   effective_yaw = robot_yaw + π 보정 후 PurePursuitController 그대로 사용
#   → delta_f 부호 자동 반전, e_theta 자동 보정
#   wheel velocity 출력 × -1 (후진)
#
# AMRMotionPurePursuit 와 동일 필드 — 역방향 전용 노드 분리 (translate_forward/reverse 패턴)

# Goal
nav_msgs/Path path           # map frame 다중 waypoint (>=2 poses, frame_id="map")
float64 max_linear_speed     # m/s (> 0, magnitude)
float64 acceleration         # m/s^2 (> 0)
bool    hold_steer           # true: skip Phase 4 steer return
float64 exit_steer_angle     # deg: Phase 4 target steer (ignored if hold_steer)
float64 exit_speed           # m/s (0=완전정지, >0=이 속도로 종료, 기본=0)
float64 entry_speed          # m/s (0=정지에서 시작, >0=이 속도로 시작)
bool    has_next             # true=다음 segment 존재 → 감속 안 함
uint8   CTRL_DEFAULT     = 0
uint8   CTRL_MODE_A      = 1
uint8   control_mode 0
# Per-goal Localization watchdog 토글 (acs_gui Link.enable_localization_watchdog 전파, 2026-05-18)
# Effective = 본 필드 AND node param (translate_enable_localization_watchdog 등). 둘 다 true 여야 작동.
bool enable_localization_watchdog true
---
# Result
int8    status               # 0=success, -1=cancelled, -2=invalid_param, -3=timeout, -4=loc_timeout, -5=loc_jump, -6=tf_lookup_fail
float64 actual_distance      # m (path 누적거리 진행)
float64 final_lateral_error  # m (closest segment 점-직선 거리, +좌 -우)
float64 final_heading_error  # deg (path tangent vs effective_yaw)
float64 elapsed_time         # sec
---
# Feedback
float64 current_distance
float64 current_lateral_error
float64 current_heading_error
float64 current_vx           # m/s (후진 시 음수)
float64 current_vy
float64 current_omega
uint8   phase                # 0=steer_align, 1=accel, 2=cruise, 3=decel, 4=steer_return
float64 w1_drive_rpm
float64 w2_drive_rpm
float64 lookahead_x          # debug: lookahead point (map frame)
float64 lookahead_y
