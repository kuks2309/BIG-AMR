# AMRMotionYawControl.action
# Goal
float64 target_yaw_deg       # target yaw to track (deg, +CCW, +-180 wrap, map-frame absolute)
float64 target_distance      # exit distance (m, > 0)
float64 vx_max               # bicycle longitudinal speed m/s (!=0, +forward/-reverse)
float64 acceleration         # vx trapezoidal accel (m/s^2)
float64 max_steer_deg        # PID output clamp (e.g. 25)
float64 kp
float64 kd
float64 ki
float64 i_max_deg            # I-term windup limit (deg)
bool    counter_steer        # steer distribution: false=front-only, true=4WS counter-steer
bool    hold_steer           # true: skip Phase 4
float64 exit_steer_angle     # Phase 4 target steer (deg, ignored if hold_steer)
float64 max_timeout_sec
# Per-goal Localization watchdog 토글 (acs_gui Link.enable_localization_watchdog 전파, 2026-05-18)
# Effective = 본 필드 AND node param (translate_enable_localization_watchdog 등). 둘 다 true 여야 작동.
bool enable_localization_watchdog true
---
# Result
int8    status               # 0=success, -1=cancelled, -2=invalid, -3=timeout, -4=loc_timeout, -5=loc_jump, -6=tf_lookup_fail,
                             # -7=heading_divergence (보정 yaw 와 맵 yaw 가 임계 초과로 벌어짐 —
                             #    측위는 멀쩡한데 IMU 쪽이 어긋난 상황. 재시도가 아니라 IMU 점검이 필요)
                             # -8=steer_unreachable (조향이 지령에 도달하지 못한 채 지속 —
                             #    구동은 가드가 0 으로 묶고 있다. can_relay·모터 쪽 점검이 필요)
                             # -9=final_yaw_tolerance (거리는 채웠으나 최종 헤딩 오차가 허용 초과 —
                             #    조향이 지령을 따라가지 못한 채 직진만 한 경우. IMU 와 맵이 둘 다
                             #    「안 돌았다」로 일치해 -7 이 뜨지 않는 사각을 막는다)
float64 actual_distance      # m
float64 final_yaw_deg
float64 final_error_deg
float64 elapsed_time
---
# Feedback
float64 current_distance
float64 remaining_distance
float64 current_yaw_deg
float64 current_error_deg
float64 current_steer_deg
float64 current_vx
uint8   phase                # 0=steer_align, 1=accel, 2=cruise, 3=decel, 4=steer_return
float64 w1_drive_rpm
float64 w2_drive_rpm
