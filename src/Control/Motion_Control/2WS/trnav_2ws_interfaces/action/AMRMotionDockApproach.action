# AMRMotionDockApproach Action — 벽 3면 측위(/wall_pose) 기준 정밀 도킹 접근
# trnav_2ws_interfaces/action/AMRMotionDockApproach
#
# 알고리즘 (trnav_2ws_dock_control 코어 — LGIT dock_control 이식본):
#   관측: /wall_pose(T_station_base) + goal 목표 → wallPoseToDockObs → {e_d, e_lat, e_yaw}
#   페이즈: PRE_ALIGN (geomEntryTranslateNeed>0 일 때만 도크면 평행 translate)
#         → APPROACH (거리 distPidStep + 기하 진입 crab geomEntryDeltaBiased
#                     + phase4Steer 합성 + 근접 감속 phase4Vcap + 속도차 yaw 미세 보정)
#         → VERIFY   (정지 후 verify_cycles 평균이 허용오차 안인지 판정, 미달 시 재접근 1회)
#   지령: composePhase4Wheels → WheelSetArray → /motion/wheel_cmd/dock (mux source 40)
#   안전: 관측 신선도/LOST 유예(steer-hold 정지) · yaw runaway 상한 · timeout.
#         모든 종료 경로에서 정지 지령 → mux 원복 순서.

# Goal
float64 target_x_m           # 도킹 목표 X (스테이션 프레임, m — wall_localizer 티치 좌표계)
float64 target_y_m           # 도킹 목표 Y (m)
float64 target_yaw_deg       # 도킹 목표 자세 (deg, 스테이션 프레임)
float64 approach_axis_deg    # base_link 기준 접근축 (0=전방 +x, +90=좌측 +y) — 실기 검증으로 확정
float64 max_speed_mps        # 접근 속도 상한 (m/s, > 0)
float64 tol_d_mm             # 완료 허용오차 — 접근축 (mm)
float64 tol_lat_mm           # 완료 허용오차 — 수평 (mm)
float64 tol_yaw_deg          # 완료 허용오차 — 자세 (deg)
float64 timeout_s            # 전체 상한 (s, 0 = 서버 기본값)
---
# Result
bool    success
int8    stop_reason          # 0 OK / 1 TIMEOUT / 2 OBS_LOST / 3 YAW_RUNAWAY / 4 PREEMPT / 5 MUX_DENIED / 6 VERIFY_FAIL
float64 final_e_d_mm
float64 final_e_lat_mm
float64 final_e_yaw_deg
float64 elapsed_s
---
# Feedback
int8    phase                # 0 PRE_ALIGN / 1 APPROACH / 2 VERIFY / 3 REAPPROACH / 4 PRE_YAW
float64 e_d_mm
float64 e_lat_mm
float64 e_yaw_deg
float64 cmd_speed_mps        # 현재 지령 속도 (진단)
