<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>telegram_notifier</name>
  <version>0.1.0</version>
  <description>can_relay /diagnostics 경보(CAN 버스 이상·피드백 두절·E-stop·릴레이 무응답)를 텔레그램으로 전송하는 감시 노드. 관측 전용이며 어떤 하드웨어도 제어하지 않는다.</description>
  <maintainer email="kukwonko@gmail.com">kuks</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
