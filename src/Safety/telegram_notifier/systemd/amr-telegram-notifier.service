# can_relay /diagnostics 경보를 텔레그램으로 보내는 감시 노드.
# 관측 전용 — 어떤 하드웨어도 제어하지 않는다. 전송 실패는 재시도 후 폐기한다.
#
# 도메인 125 는 amr-can-relay.service 와 같은 값이어야 /diagnostics 가 보인다.
# ROS 는 /opt/ros/humble 만 source 한다 — 표준 메시지(diagnostic_msgs)만 쓰므로
# 오버레이가 필요 없고, colcon build 가 install/ 을 비워도 죽지 않는다.
#
# 설치는 install_service.sh 가 명시 실행될 때만 한다. 저장소에 파일이 있다고 해서
# 자동으로 활성화되지 않는다.
#
# **본 파일은 템플릿이다.** __PKGROOT__·__CONFIG__ 는 설치 시점에 치환된다.

[Unit]
Description=AMR telegram notifier (can_relay /diagnostics -> Telegram, observe-only)
Documentation=file://__PKGROOT__/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nvidia
Group=nvidia
Environment=PYTHONUNBUFFERED=1
Environment=ROS_DOMAIN_ID=125
Environment=PYTHONPATH=__PKGROOT__
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && exec python3 -m telegram_notifier.notifier_node --config __CONFIG__'
Restart=always
RestartSec=5
# 감시가 대상을 방해하지 않게 한다(system_health 관례)
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
