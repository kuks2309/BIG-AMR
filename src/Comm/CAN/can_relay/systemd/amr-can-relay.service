# can_relay 드라이버 — 기동만 하고 **제어권은 잡지 않는다.**
#
# 이 유닛이 하는 일은 프로세스를 살려 두는 것뿐이다. 되살아난 노드는 대기 상태이며,
# 버스를 Seer 에게서 가져오는 것은 `~/engage` 명시 호출뿐이다
# (`launch/can_relay.launch.py` · `PandaLink` 는 engage 이전에 USB 를 열지도 않는다).
# 그래서 자동 재기동이 launch 주석의 「재기동은 사람이 판단한다」와 충돌하지 않는다 —
# 사람 판단 영역은 **제어권 획득**이고, 그쪽은 감시자가 기록에 근거해 되돌린다.
#
# 설치는 install_service.sh 가 명시 실행될 때만 한다. 저장소에 파일이 있다고 해서
# 자동으로 활성화되지 않는다.
#
# **본 파일은 템플릿이다.** @REPO@·@USER@·@GROUP@·@DOMAIN@ 은 설치 시점에 치환된다.

[Unit]
Description=AMR can_relay driver (idle on start; never auto-engages)
Documentation=file://@REPO@/docs/adr/2026-08-15-can-relay-node-health-supervision.md
After=network.target local-fs.target

# crash-loop 차단 — 3회/120초를 넘으면 멈추고 사람을 부른다. 무한 재기동은 그때마다
# Seer 에게서 버스를 뺏었다 놓는 것이라, 죽은 채 있는 것보다 나쁘다.
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=@USER@
Group=@GROUP@
Environment=PYTHONUNBUFFERED=1
Environment=ROS_DOMAIN_ID=@DOMAIN@
# 오버레이를 source 해야 rclpy·trnav_msgs 가 잡힌다.
# ⚠ `colcon build` 중에는 install/ 이 일시적으로 불완전해 기동이 실패할 수 있다.
#   그 실패도 StartLimitBurst 를 소모하므로, 빌드 전에는 `systemctl stop` 을 권한다.
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && source @REPO@/install/setup.bash && exec ros2 launch can_relay can_relay.launch.py@MACHINE_ARG@'

# 어떤 종료든 되살린다. `on-failure` 로는 크래시 소생이 발동하지 않는다 —
# 노드가 죽으면 `ros2 launch` 가 required-프로세스 종료를 정상 셧다운으로 처리해
# **exit 0** 으로 내려가므로 systemd 눈에는 실패가 아니다. `systemctl stop` 은
# `Restart=always` 에서도 재기동을 만들지 않으므로 수동 정지와는 충돌하지 않는다.
Restart=always
RestartSec=3

# 종료 시 노드가 정지 → 제어권 반환 → 닫기를 마칠 시간을 준다(`destroy_node`).
# 여기서 잘라 버리면 제어권을 쥔 채 프로세스가 사라져 펌웨어 fail-safe 로 떨어진다 —
# 안전하긴 하지만 불필요하게 Seer 인수를 유발한다.
KillSignal=SIGINT
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
