[Unit]
# 6대를 한 번에 켜고 끄기 위한 묶음. 개별 제어는 usb-cam@cam0 처럼 인스턴스로 한다.
#   systemctl start usb-cam.target      # 전체 기동
#   systemctl restart usb-cam@cam3      # 3번만 재시작
Description=All USB CCTV camera publishers
Wants=usb-cam@cam_f.service usb-cam@cam_r.service usb-cam@cam_lf.service usb-cam@cam_lr.service usb-cam@cam_rf.service usb-cam@cam_rr.service

[Install]
WantedBy=multi-user.target
